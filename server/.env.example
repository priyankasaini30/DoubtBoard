PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/doubtboard
# Comma-separated origins allowed to call the API (use your deployed client URL in production)
CLIENT_ORIGIN=http://localhost:5173

# Signs anonymous voter tokens. REQUIRED in production: use a long random string
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
VOTER_SECRET=

# Set from your own evaluation: run `npm run eval` on your labelled pairs
SIMILARITY_THRESHOLD=0.3
# Higher = old questions sink faster
RANK_GRAVITY=1.5
# Questions used to fit IDF for suggestions (defaults to eval/pairs.csv)
# BACKGROUND_CSV=eval/pairs.csv

QUESTIONS_PER_MINUTE=5
API_REQUESTS_PER_MINUTE=600
ROOMS_PER_HOUR=20
VOTERS_PER_HOUR=500
MAX_QUESTIONS_PER_ROOM=1000
