{
  "name": "doubtboard-server",
  "version": "1.0.0",
  "description": "DoubtBoard backend: live Q&A rooms with duplicate-question suggestions",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
